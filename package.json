{
  "name": "neighbors",
  "version": "0.0.0",
  "description": "A single-player logic puzzle: place buildings so every number agrees with the neighbours touching it",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vp dev",
    "preview": "vp preview",
    "build": "vp build",
    "oxlint": "vp lint . --fix",
    "oxlint:ci": "vp lint . --format github",
    "fmt": "vp fmt",
    "fmt:ci": "vp fmt --check",
    "fallow": "fallow fix --yes",
    "fallow:ci": "fallow dead-code",
    "typecheck": "tsc --noEmit",
    "test": "node node_modules/vitest/dist/cli.js",
    "test:ui": "node node_modules/vitest/dist/cli.js --ui",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test-storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6007 --silent\" \"npx wait-on tcp:127.0.0.1:6007 && test-storybook --url http://127.0.0.1:6007\"",
    "deploy": "wrangler pages deploy",
    "prepare": "VITE_GIT_HOOKS=0 vp config"
  },
  "dependencies": {
    "agentation": "^3.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "wrangler": "^4.149.0",
    "eslint-plugin-storybook": "^10.6.2",
    "fallow": "^3.33.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "markdownlint-cli2": "^0.23.3",
    "playwright": "^1.64.0",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.7.0"
}
